# ============================================================
# FBot — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- Database (PostgreSQL in Docker) ---
POSTGRES_USER=fbot
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=fbot
DATABASE_URL=postgresql+asyncpg://fbot:changeme_strong_password@db:5432/fbot

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_personal_chat_id

# --- Zerodha Kite Connect ---
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=

# --- Ollama (sentiment analysis — runs as Docker service) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e2b

# --- NewsAPI (Optional) ---
NEWS_API_KEY=

# --- Application Settings ---
TRADING_MODE=paper
LOG_LEVEL=INFO
SCAN_UNIVERSE=nifty500
MAX_POSITION_PCT=10.0
DAILY_BUY_LIMIT=10
MAX_CMP_ENTRY_DEVIATION_PCT=5.0
BASE_URL=https://kuber-bot.duckdns.org
